# Copy to repository-root .env; never commit real values.
DATABASE_URL=mysql+asyncmy://chatuser:CHANGE_ME@127.0.0.1:3306/groupchat
JWT_SECRET=please_change_me_to_a_long_random_value
JWT_EXPIRE_MINUTES=1440
# Enable before public exposure; share invitation privately with the class group.
PUBLIC_MODE=false
REGISTRATION_CODE=
# Exact HTTPS origin, for WebSocket origin validation behind a reverse proxy.
PUBLIC_ORIGIN=
# Optional overrides of config/project.json:
APP_HOST=127.0.0.1
APP_PORT=8000
LLM_API_BASE=http://127.0.0.1:8001/v1
# Match the actual self-hosted endpoint; placeholder, not a verified model ID.
LLM_MODEL=llama-3-8b-instruct
LLM_API_KEY=
# C: official OpenAI API (Part 3). gpt-6-luna accepts only the default temperature.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional isolated local MySQL (infra/compose.mysql.yml, port 13306).
# Set DATABASE_URL to the same username/password and port when using it.
LAB9_MYSQL_PASSWORD=
LAB9_MYSQL_ROOT_PASSWORD=

# A deployment (infra/compose.a.yml): set before enabling the HTTPS profile.
LAB9_DOMAIN=
ACME_EMAIL=
# Docker Llama service, or another reachable model endpoint in the Docker network.
DOCKER_LLM_API_BASE=http://llama:8001/v1
LLAMA_MODEL_DIR=../models
LLAMA_MODEL_FILE=model.gguf
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server
